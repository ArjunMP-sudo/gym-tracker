# Copy to .env.local for local dev. In Vercel, set these in Project Settings > Environment Variables.
# Never commit real values.

# Login password for the app (long and unique)
APP_PASSWORD=change-me-to-a-long-passphrase
# Random string, 32+ chars (generate: openssl rand -base64 48)
SESSION_SECRET=replace-with-random-32+-characters-xxxxxxxx

# Private data repo (NOT the app repo). Fine-grained token: only that repo, Contents: Read and write.
GITHUB_TOKEN=github_pat_placeholder
GITHUB_OWNER=your-github-username
GITHUB_REPO=fitness-data
GITHUB_BRANCH=main
