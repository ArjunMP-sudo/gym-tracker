# Only one variable is needed. Set it in Vercel > Settings > Environment Variables.
APP_PASSWORD=choose-a-password

# Storage: in Vercel go to Storage > Create > Upstash Redis > Connect to project.
# Vercel adds KV_REST_API_URL and KV_REST_API_TOKEN automatically. Do not type them yourself.
# For local dev only, copy those two values from the Vercel dashboard into .env.local.
